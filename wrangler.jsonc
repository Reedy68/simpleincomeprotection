{
  "name": "simpleincomeprotection",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-12",
  // Every request runs src/worker.js first (19 Nov 2026). Real files are passed straight through with their _headers
  // caching; anything missing gets the 404 page marked no-store (notFound in src/worker.js). Before, Cloudflare answered
  // missing /assets/ files itself and _headers gave those 404s "cache for a year, immutable".
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "VM_API_BASE": "https://api.vmleads.co.uk",
    "LIVE_HOSTS": "simpleincomeprotection.co.uk,www.simpleincomeprotection.co.uk",
    "REFERER_ORIGIN": "https://simpleincomeprotection.co.uk",
    "DEFAULT_SOURCE": "ppcsearch",
    "FAILED_URL": "/failed/",
    "AB_ENABLED": "0",
    "AB_SITE": "simpleincomeprotection.co.uk",
    "AB_PATH": "/",
    "AB_B_PATH": "/",
    "AB_SPLIT": "50"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "blab-ab", "database_id": "a2e67966-30dd-438f-8931-e6ddc2974645" }
  ],
  "observability": { "enabled": true }
}
